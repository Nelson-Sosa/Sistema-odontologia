# ════════════════════════════════════════════════════════════════
# Sistema Odontológico — Environment Variables Example
# ════════════════════════════════════════════════════════════════
# Este archivo SÍ se commitea al repositorio.
# Contiene la lista de variables requeridas (sin valores reales).
# Para configurar el proyecto:
#   1. Copiá este archivo como .env.local
#   2. Completá con tus credenciales reales del proyecto Firebase
#   3. NUNCA commitees .env.local (ya está en .gitignore)
# ════════════════════════════════════════════════════════════════

# ── Firebase Configuration ────────────────────────────────────────
# Obtené estos valores desde Firebase Console → Project Settings → Your apps
# https://console.firebase.google.com/project/YOUR_PROJECT_ID/settings/general
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── App Configuration ─────────────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_NAME=Sistema Odontológico

# ── Cloudinary (Subida de comprobantes de pago) ────────────────────
# Obtené estos valores desde Cloudinary Dashboard → Settings
# https://console.cloudinary.com/settings
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=